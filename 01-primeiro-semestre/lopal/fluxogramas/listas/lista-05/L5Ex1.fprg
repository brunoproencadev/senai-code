<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="L5Ex1"/>
        <attribute name="authors" value="Bruno Proen&#231;a"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-02 08:43:27 AM"/>
        <attribute name="created" value="QnJ1bm8gUHJvZW7Dp2E7REVWLTE1MzE0Njk7MjAyNi0wNC0wMjswODowOTo1MyBBTTszMjk3"/>
        <attribute name="edited" value="QnJ1bm8gUHJvZW7Dp2E7REVWLTE1MzE0Njk7MjAyNi0wNC0wMjswODo0MzoyNyBBTTsyOzM0MDU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="option, a, b, assign" type="Integer" array="False" size=""/>
            <output expression="&quot;**********CALCULATOR**********&quot;" newline="True"/>
            <output expression="&quot;1 - Adi&#231;&#227;o&quot; &amp; ToChar(13) &amp; &quot;2 - Subtra&#231;&#227;o&quot; &amp; ToChar(13) &amp; &quot;3 - Multiplica&#231;&#227;o&quot; &amp; ToChar(13) &amp; &quot;4 - Divis&#227;o&quot;" newline="True"/>
            <output expression="&quot;******************************&quot;" newline="True"/>
            <output expression="&quot;Digite o n&#250;mero da op&#231;&#227;o desejada: &quot;" newline="False"/>
            <input variable="option"/>
            <output expression="&quot;******************************&quot;" newline="True"/>
            <output expression="&quot;Digite o primeiro n&#250;mero: &quot;" newline="False"/>
            <input variable="a"/>
            <output expression="&quot;Digite o segundo n&#250;mero: &quot;" newline="False"/>
            <input variable="b"/>
            <output expression="&quot;******************************&quot;" newline="True"/>
            <if expression="option == 1">
                <then>
                    <assign variable="assign" expression="a + b"/>
                    <output expression="&quot;Resultado da soma: &quot; &amp; assign" newline="True"/>
                    <output expression="&quot;******************************&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="option == 2">
                        <then>
                            <assign variable="assign" expression="a - b"/>
                            <output expression="&quot;Resultado da subtra&#231;&#227;o: &quot; &amp; assign" newline="True"/>
                        </then>
                        <else>
                            <if expression="option == 3">
                                <then>
                                    <assign variable="assign" expression="a * b"/>
                                    <output expression="&quot;Resultado da multiplica&#231;&#227;o: &quot; &amp; assign" newline="True"/>
                                </then>
                                <else>
                                    <if expression="b == 0">
                                        <then>
                                            <output expression="&quot;Error: Division by zero!&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <assign variable="assign" expression="a / b"/>
                                            <output expression="&quot;Resultado da divis&#227;o: &quot; &amp; assign" newline="True"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                    <output expression="&quot;******************************&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
