<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Ex6 - AreaPerimetro"/>
        <attribute name="authors" value="Bruno Proen&#231;a"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-02-26 07:43:46 AM"/>
        <attribute name="created" value="QnJ1bm8gUHJvZW7Dp2E7REVWLTE1MzE0Njk7MjAyNi0wMi0yNjswNzozODoyOCBBTTszMzA0"/>
        <attribute name="edited" value="QnJ1bm8gUHJvZW7Dp2E7REVWLTE1MzE0Njk7MjAyNi0wMi0yNjswNzo0Mzo0NiBBTTsxOzM0MDg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="lado, perimetro, area" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o valor do lado do quadrado: &quot;" newline="True"/>
            <input variable="lado"/>
            <assign variable="perimetro" expression="lado * 4"/>
            <assign variable="area" expression="lado * lado"/>
            <output expression="&quot;Per&#237;metro: &quot; &amp; perimetro" newline="True"/>
            <output expression="&quot;&#193;rea: &quot; &amp; area" newline="True"/>
        </body>
    </function>
</flowgorithm>
