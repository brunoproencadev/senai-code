    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, num2, soma" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero: &quot;" newline="False"/>
            <input variable="num1"/>
            <output expression="&quot;Digite outro numero: &quot;" newline="False"/>
            <input variable="num2"/>
            <assign variable="soma" expression="num1 + num2"/>
            <output expression="&quot;SOMA DOS DOIS NUMEROS: &quot;" newline="True"/>
            <output expression="soma" newline="True"/>
        </body>
    </function>
