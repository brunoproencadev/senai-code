    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero: &quot;" newline="False"/>
            <input variable="a"/>
            <output expression="&quot;Digite outro n&#250;mero: &quot;" newline="True"/>
