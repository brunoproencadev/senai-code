    <attributes>
        <attribute name="name" value="L3Ex4"/>
        <attribute name="authors" value="Bruno Proen&#231;a"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-03-24 10:01:22 AM"/>
        <attribute name="created" value="QnJ1bm8gUHJvZW7Dp2E7REVWLTE1MzE0Njk7MjAyNi0wMy0yNDswOTo1OToxMiBBTTszMzAx"/>
        <attribute name="edited" value="QnJ1bm8gUHJvZW7Dp2E7REVWLTE1MzE0Njk7MjAyNi0wMy0yNDsxMDowMToyMiBBTTsxOzMzODk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c" type="Real" array="False" size=""/>
            <output expression="&quot;Digite a nota 1: &quot;" newline="False"/>
            <input variable="a"/>
            <output expression="&quot;Digite a nota 2: &quot;" newline="False"/>
            <input variable="b"/>
            <assign variable="c" expression="(a + b) / 2.0"/>
            <if expression="c &gt;= 60">
                <then>
                    <output expression="&quot;Approved&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Reproved&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
