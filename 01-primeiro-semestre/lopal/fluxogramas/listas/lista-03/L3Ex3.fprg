    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a" type="Real" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero: &quot;" newline="False"/>
            <input variable="a"/>
            <if expression="a &lt; 0">
                <then>
                    <output expression="&quot;O n&#250;mero &#233; negativo!&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="a = 0">
                        <then>
                            <output expression="&quot;O n&#250;mero &#233; zero!&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;O n&#250;mero &#233; positivo!&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
