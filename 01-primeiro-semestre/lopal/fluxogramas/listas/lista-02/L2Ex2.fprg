    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c, geometricMean" type="Real" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero: &quot;" newline="False"/>
            <input variable="a"/>
            <output expression="&quot;Digite um segundo n&#250;mero: &quot;" newline="False"/>
            <input variable="b"/>
            <output expression="&quot;Digite um terceiro n&#250;mero: &quot;" newline="True"/>
            <input variable="c"/>
            <assign variable="geometricMean" expression="(a * b * c) ^ (1.0/3.0)"/>
            <output expression="&quot;M&#233;dia Geom&#233;trica: &quot; &amp; geometricMean" newline="True"/>
        </body>
    </function>
</flowgorithm>
