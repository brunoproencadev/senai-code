    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="r, area" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o raio em mm: &quot;" newline="False"/>
            <input variable="r"/>
            <assign variable="area" expression="3.14 * (raio ^ 2)"/>
            <output expression="&quot;&#193;rea: &quot; &amp; area &amp; &quot;mm.&quot;" newline="True"/>
        </body>
    </function>
