    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valorTotal, valorPago, troco" type="Real" array="False" size=""/>
            <output expression="&quot;Valor total da compra: &quot;" newline="False"/>
            <input variable="valorTotal"/>
            <output expression="&quot;Valor pago: &quot;" newline="True"/>
            <input variable="valorPago"/>
            <assign variable="troco" expression="valorTotal - valorPago"/>
            <output expression="&quot;Troco: &quot; + troco" newline="True"/>
        </body>
    </function>
</flowgorithm>
