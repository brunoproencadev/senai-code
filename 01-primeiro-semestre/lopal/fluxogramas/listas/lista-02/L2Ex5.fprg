    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="c, f" type="Real" array="False" size=""/>
            <output expression="&quot;Digite a temperatura em graus Celcius: &quot;" newline="False"/>
            <input variable="c"/>
            <assign variable="f" expression="(c * (9.0/5.0)) + 32"/>
            <output expression="&quot;Graus Farenheit: &quot; + f" newline="True"/>
        </body>
    </function>
