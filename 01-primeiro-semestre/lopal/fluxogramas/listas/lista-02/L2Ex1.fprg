    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, sum, sub, multi, div" type="Real" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero:&quot;" newline="False"/>
            <input variable="a"/>
            <output expression="&quot;Digite outro n&#250;mero: &quot;" newline="False"/>
            <input variable="b"/>
            <assign variable="sum" expression="a + b"/>
            <assign variable="sub" expression="a - b"/>
            <assign variable="multi" expression="a * b"/>
            <assign variable="div" expression="a / b"/>
            <output expression="&quot; Soma: &quot; &amp;  soma &amp;&#13;&#10;&quot; Subtra&#231;&#227;o: &quot; &amp; sub &amp;&#13;&#10;&quot; Multiplica&#231;&#227;o: &quot; &amp; multi &amp;&#13;&#10;&quot; Divis&#227;o: &quot; &amp; div" newline="True"/>
        </body>
    </function>
