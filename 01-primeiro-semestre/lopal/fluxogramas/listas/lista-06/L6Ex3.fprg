        <attribute name="edited" value="QnJ1bm8gUHJvZW7Dp2E7REVWLTE1MzE0Njk7MjAyNi0wNC0wNzswOTo1Njo1MyBBTTsxOzM0MTM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="grade" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite a nota final do aluno: &quot;" newline="False"/>
            <input variable="grade"/>
            <if expression="grade &lt; 50">
                <then>
                    <output expression="&quot;Reprovado&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="grade &lt;= 69">
                        <then>
                            <output expression="&quot;Recupera&#231;&#227;o&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="grade &lt;=79">
                                <then>
                                    <output expression="&quot;Aprovado&quot;" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;Aprovado com Honra&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
