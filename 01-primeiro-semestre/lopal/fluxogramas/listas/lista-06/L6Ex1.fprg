        <attribute name="edited" value="QnJ1bm8gUHJvZW7Dp2E7REVWLTE1MzE0Njk7MjAyNi0wNC0wNzswOTo0MTo1MSBBTTsxOzM0MDU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="age" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite sua idade: &quot;" newline="False"/>
            <input variable="age"/>
            <if expression="age &lt;= 12">
                <then>
                    <output expression="&quot;Infantil&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="age &lt;= 17">
                        <then>
                            <output expression="&quot;Juvenil&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="age &lt;= 40">
                                <then>
                                    <output expression="&quot;Adulto&quot;" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;Master&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
