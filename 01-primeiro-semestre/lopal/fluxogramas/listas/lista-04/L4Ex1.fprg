    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero: &quot;" newline="False"/>
            <input variable="a"/>
            <output expression="&quot;Digite um n&#250;mero: &quot;" newline="False"/>
            <input variable="b"/>
            <output expression="&quot;Digite um n&#250;mero: &quot;" newline="False"/>
            <input variable="c"/>
            <if expression="a + b + c % 5 ==0">
                <then>
                    <output expression="&quot;A soma &#233; divis&#237;vel por cinco!&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;A soma n&#227;o &#233; divis&#237;vel por cinco!&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
