        <attribute name="edited" value="QnJ1bm8gUHJvZW7Dp2E7REVWLTE1MzE0Njk7MjAyNi0wMy0yNjsxMjowNjo0MCBQTTsxOzM0MTM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c, mean" type="Real" array="False" size=""/>
            <output expression="&quot;Digite a nota 1: &quot;" newline="False"/>
            <input variable="a"/>
            <output expression="&quot;Digite a nota 2: &quot;" newline="False"/>
            <input variable="b"/>
            <output expression="&quot;Digite a nota 3: &quot;" newline="False"/>
            <input variable="c"/>
            <assign variable="mean" expression="(a + b + c) / 3.0"/>
            <if expression="mean &gt;= 7">
                <then>
                    <output expression="&quot;M&#233;dia: &quot; &amp; mean" newline="True"/>
                    <output expression="&quot;Status: Aprovado!&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="mean &gt;= 4 &amp;&amp; mean &lt;= 7">
                        <then>
                            <output expression="&quot;M&#233;dia: &quot; &amp; mean" newline="True"/>
                            <output expression="&quot;Status: Recupera&#231;&#227;o!&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;M&#233;dia: &quot; &amp; mean" newline="True"/>
                            <output expression="&quot;Status: Reprovado!&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
