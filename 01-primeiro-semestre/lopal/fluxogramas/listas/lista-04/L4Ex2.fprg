        <attribute name="edited" value="QnJ1bm8gUHJvZW7Dp2E7REVWLTE1MzE0Njk7MjAyNi0wMy0yNjsxMDo1Mjo0NSBBTTsxOzM0MDI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero: &quot;" newline="False"/>
            <input variable="a"/>
            <output expression="&quot;Digite um n&#250;mero: &quot;" newline="False"/>
            <input variable="b"/>
            <output expression="&quot;Digite um n&#250;mero: &quot;" newline="False"/>
            <input variable="c"/>
            <if expression="a + b + c &lt; 0">
                <then>
                    <output expression="&quot;A soma &#233; negativa!&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="a + b + c == 0">
                        <then>
                            <output expression="&quot;A soma &#233; igual a zero!&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;A soma &#233; positiva!&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
